use std::cli;
use std::text;
use vendor::dispatch_manifest::dispatch_manifest;

fn main() {
    let arguments = cli_args();
    if args_len(arguments) > 0 {
        if args_len(arguments) % 2 != 0 {
            stderr_line("Expected event and value pairs");
            process_exit(2);
        }
        let mut live = dispatch_manifest_start();
        let mut i = 0;
        while i < args_len(arguments) {
            let input = args_at(arguments, i + 1);
            if !text_is_number(input) {
                stderr_line("Expected a whole numeric event value");
                process_exit(2);
            }
            live = dispatch_manifest_step(live, args_at(arguments, i), text_number(input));
            let command = dispatch_manifest_command(live);
            println!(command);
            if command == "reject" { process_exit(1); }
            i += 2;
        }
        return;
    }
    let mut state = dispatch_manifest_start();
    state = dispatch_manifest_step(state, "stops", 3.0);
    println!(dispatch_manifest_command(state));
    state = dispatch_manifest_step(state, "scan", 0.0);
    println!(dispatch_manifest_command(state));
    state = dispatch_manifest_step(state, "remove", 2.0);
    println!(dispatch_manifest_command(state));
    state = dispatch_manifest_step(state, "depart", 0.0);
    println!(dispatch_manifest_command(state));
    state = dispatch_manifest_step(state, "return", 0.0);
    println!(dispatch_manifest_command(state));
}
