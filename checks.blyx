use std::cli;
use vendor::dispatch_manifest::dispatch_manifest;

fn main() {
    let mut state = dispatch_manifest_start();
    state = dispatch_manifest_step(state, "stops", 3.0);
    println!(dispatch_manifest_command(state));
    state = dispatch_manifest_step(state, "scan", 0.0);
    println!(dispatch_manifest_command(state));
    state = dispatch_manifest_step(state, "remove", 2.0);
    println!(dispatch_manifest_command(state));
    state = dispatch_manifest_step(state, "depart", 0.0);
    println!(dispatch_manifest_command(state));
    state = dispatch_manifest_step(state, "return", 0.0);
    println!(dispatch_manifest_command(state));
    println!(len(dispatch_manifest_step([], "bad", 0.0)));
    println!(dispatch_manifest_command(dispatch_manifest_step(dispatch_manifest_start(), "unrecognized", 0.0)));
    println!(len(dispatch_manifest_replay(args_new(), [1])));
    let mut events = args_new();
    events = args_push(events, "stops");
    events = args_push(events, "scan");
    events = args_push(events, "remove");
    events = args_push(events, "depart");
    events = args_push(events, "return");
    println!(dispatch_manifest_command(dispatch_manifest_replay(events, [3, 0, 2, 0, 0])));
    let branch_0 = dispatch_manifest_step([0, 0, 0], "stops", 1.0);
    println!(at(branch_0, 0) == 1.0 && at(branch_0, 1) == 1.0 && dispatch_manifest_command(branch_0) == "open_manifest");
    let branch_1 = dispatch_manifest_step([1, 1, 0], "scan", 0.0);
    println!(at(branch_1, 0) == 1.0 && at(branch_1, 1) == 0.0 && dispatch_manifest_command(branch_1) == "accept_scan");
    let branch_2 = dispatch_manifest_step([1, 1, 0], "remove", 1.0);
    println!(at(branch_2, 0) == 1.0 && at(branch_2, 1) == 0.0 && dispatch_manifest_command(branch_2) == "remove_stops");
    let branch_3 = dispatch_manifest_step([1, 0, 0], "depart", 0.0);
    println!(at(branch_3, 0) == 2.0 && at(branch_3, 1) == 0.0 && dispatch_manifest_command(branch_3) == "seal_manifest");
    let branch_4 = dispatch_manifest_step([2, 0, 0], "return", 0.0);
    println!(at(branch_4, 0) == 3.0 && at(branch_4, 1) == 0.0 && dispatch_manifest_command(branch_4) == "close_route");
}
